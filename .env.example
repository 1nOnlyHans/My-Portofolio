VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Google reCAPTCHA v2 "I'm not a robot" Checkbox site key (not a v3 key)
VITE_RECAPTCHA_SITE_KEY=

# Backend (Vercel Functions in api/) — server-side only, no VITE_ prefix
# Neon Postgres connection string (Vercel Marketplace > Neon sets this for you)
DATABASE_URL=
# Admin login password for /admin
ADMIN_PASSWORD=
# Vercel Blob read/write token for image uploads (Storage > Create > Blob; Vercel sets it)
BLOB_READ_WRITE_TOKEN=
# Random string, 32+ chars, signs the session cookie
JWT_SECRET=
